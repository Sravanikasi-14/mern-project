# ==============================================================================
# HRMS Production Environment Variables for Render
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=10000

# MongoDB Atlas Database Connection (Required)
# Replace with your actual MongoDB Atlas connection string.
# Ensure your MongoDB Atlas IP Access List has 0.0.0.0/0 enabled for Render.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
CENTRAL_DB_NAME=platform

# Authentication & JWT Security (Required)
# Generate a secure random string (minimum 32 characters, e.g. using `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h
JWT_ISSUER=hrms-platform
JWT_AUDIENCE=hrms-company-users
AUTH_COOKIE_NAME=hrms_auth
BCRYPT_ROUNDS=12
ONBOARDING_TOKEN_EXPIRES_IN=7d

# Application URL & Client Origin
# In Single-Service deployment, this can be your Render URL (e.g. https://your-app.onrender.com)
CLIENT_URL=https://your-service-name.onrender.com

# Document Storage (Optional)
# Defaults to "uploads" directory in project root. If using Render persistent disk, set mount path here.
# UPLOADS_DIR=/var/data/uploads
