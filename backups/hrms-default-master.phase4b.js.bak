/**
 * HRMS default master offer-letter template (HRMS_DEFAULT_V1).
 *
 * Sanitised, brand-neutral structure modelled on a professional multi-page
 * Indian employment offer:
 *   Page 1  – letterhead, OFFER LETTER title, offer body, signatory + acceptance
 *   Page 2+ – numbered legal sections (uppercase dark-blue titles, bold lead-ins)
 *   Final   – EXECUTION page with dual signature blocks + footer contacts
 *
 * No personal names, phone numbers, or company branding live here. Every
 * company-specific value is supplied through `{{placeholders}}` (inside the
 * section text) or through the `context` object passed to `buildMasterOfferHtml`.
 * All values are HTML-escaped by `buildMasterOfferHtml`; callers pass RAW values.
 */

export const MASTER_TEMPLATE_CODE = "HRMS_DEFAULT_V1";
export const MASTER_TEMPLATE_TITLE = "HRMS Default Offer Letter";
export const MASTER_TEMPLATE_VERSION = 1;
export const MASTER_TEMPLATE_KIND = "DEFAULT_BUILDER";

/** Placeholders understood inside section text (snake_case). */
export const MASTER_PLACEHOLDERS = Object.freeze([
  "company_name",
  "company_email",
  "company_phone",
  "company_website",
  "company_address",
  "candidate_name",
  "candidate_email",
  "designation",
  "department",
  "employment_type",
  "work_location",
  "reporting_manager",
  "joining_date",
  "offer_date",
  "monthly_salary",
  "annual_salary",
  "probation_months",
  "probation_notice_days",
  "notice_period_days",
  "office_hours",
  "working_days",
  "acceptance_days",
  "signatory_name",
  "signatory_title",
  "place",
]);

/** Cover-letter (page 1) configuration. Terms support **bold** and placeholders. */
export const MASTER_COVER = Object.freeze({
  id: "cover_letter",
  kind: "cover",
  title: "OFFER LETTER",
  salutation: "Dear {{candidate_name}},",
  paragraphs: Object.freeze([
    "We are pleased to offer you employment with **{{company_name}}** (the \"Company\") in the position of **{{designation}}** on a **{{employment_type}}** basis. Your proposed date of joining is **{{joining_date}}**, and you will be based at **{{work_location}}**.",
    "Your gross monthly compensation will be **{{monthly_salary}}** (annualised compensation of **{{annual_salary}}**), subject to statutory deductions and the terms set out in the pages that follow.",
    "This offer is made on the terms and conditions in the enclosed Terms of Employment, which form an integral part of this letter. Please confirm your acceptance by signing below within **{{acceptance_days}} days** of the date of this letter. We look forward to welcoming you to the team.",
  ]),
  closing: "Yours sincerely,",
});

