/** Execution page configuration. */
export const MASTER_EXECUTION = Object.freeze({
  id: "execution",
  kind: "execution",
  title: "EXECUTION",
  statement:
    "By signing below, the parties confirm that they have read, understood, and agreed to the terms of this Offer Letter and the Terms of Employment set out above.",
});

/** Full ordered structure: cover → legal sections → execution. */
export const MASTER_SECTIONS = Object.freeze([
  MASTER_COVER,
  ...DEFAULT_LEGAL_SECTIONS.map((s) => ({ ...s, kind: "section" })),
  MASTER_EXECUTION,
]);

/** Plain-JSON config persisted on the master and copied into tenant templates. */
export function getMasterSectionConfig() {
  return JSON.parse(
    JSON.stringify({
      cover: MASTER_COVER,
      execution: MASTER_EXECUTION,
      defaults: {
        probationMonths: 3,
        probationNoticeDays: 30,
        noticeDays: 60,
        officeHours: "09:30 AM to 06:30 PM",
        workingDays: "Monday to Friday",
        acceptanceDays: 5,
      },
    })
  );
}

export function getDefaultLegalSections() {
  return JSON.parse(JSON.stringify(DEFAULT_LEGAL_SECTIONS));
}

// ---------------------------------------------------------------------------
// Rendering helpers
// ---------------------------------------------------------------------------

export function esc(value) {
  if (value == null) return "";
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function fmtDate(value) {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(d.getTime())) return String(value);
  return d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
}

function fmtMoney(value) {
  if (value == null || value === "") return "";
  if (typeof value === "string" && !/^[\d.,\s]+$/.test(value)) return value; // already formatted
  const n = Number(String(value).replace(/,/g, ""));
  if (!Number.isFinite(n)) return String(value);
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 0,
  }).format(n);
}

/** Only allow safe raster data URLs for the logo <img>. */
function safeLogoSrc(src) {
  if (typeof src !== "string") return "";
  return /^data:image\/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=]+$/.test(src) ? src : "";
}

/** Build the `{{key}}` → raw value map from a render context. */
export function buildPlaceholderValues(context = {}) {
  const defaults = context.defaults || {};
  const monthly = context.monthlySalary;
  const annualRaw =
    context.annualSalary != null && context.annualSalary !== ""
      ? context.annualSalary
      : Number.isFinite(Number(monthly))
        ? Number(monthly) * 12
        : "";
  return {
    company_name: context.companyName || "",
    company_email: context.companyEmail || "",
    company_phone: context.companyPhone || "",
    company_website: context.companyWebsite || "",
    company_address: context.companyAddress || "",
    candidate_name: context.candidateName || "",
    candidate_email: context.candidateEmail || "",
    designation: context.designation || "",
    department: context.department || "the relevant",
    employment_type: context.employmentType || "Full-time Permanent",
    work_location: context.workLocation || "the Company's office",
    reporting_manager: context.reportingManager || "your designated manager",
    joining_date: fmtDate(context.joiningDate),
    offer_date: fmtDate(context.offerDate || new Date()),
    monthly_salary: fmtMoney(monthly),
    annual_salary: fmtMoney(annualRaw),
    probation_months: context.probationMonths ?? defaults.probationMonths ?? 3,
    probation_notice_days: context.probationNoticeDays ?? defaults.probationNoticeDays ?? 30,
    notice_period_days: context.noticeDays ?? defaults.noticeDays ?? 60,
    office_hours: context.officeHours || defaults.officeHours || "09:30 AM to 06:30 PM",
    working_days: context.workingDays || defaults.workingDays || "Monday to Friday",
    acceptance_days: context.acceptanceDays ?? defaults.acceptanceDays ?? 5,
    signatory_name: context.signatoryName || "",
    signatory_title: context.signatoryTitle || "Authorized Signatory",
    place: context.place || context.workLocation || "",
  };
}

/** Escape text, resolve `{{key}}` placeholders (escaped) and `**bold**` markup. */
export function renderRichText(text, values) {
  let out = esc(text || "");
  out = out.replace(/\{\{\s*([a-z0-9_]+)\s*\}\}/gi, (match, key) => {
    const k = key.toLowerCase();
    return Object.prototype.hasOwnProperty.call(values, k) ? esc(values[k]) : match;
  });
  out = out.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  return out;
}

const MASTER_CSS = `
  @page { size: A4 portrait; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: #ffffff; }
  body {
    font-family: "Georgia", "Times New Roman", Times, serif;
    font-size: 12px;
    line-height: 1.6;
    color: #1f2937;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page {
    width: 100%;
    max-width: 794px;
    margin: 0 auto;
    padding: 8px 12px;
    page-break-after: always;
    break-after: page;
  }
  .page:last-child { page-break-after: auto; break-after: auto; }
  .letterhead { text-align: center; padding-bottom: 10px; }
  .letterhead img.logo { max-height: 64px; max-width: 220px; object-fit: contain; margin-bottom: 8px; }
  .company-name {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 21px; font-weight: 700; letter-spacing: 1.5px;
    text-transform: uppercase; color: #0b1f3a;
  }
  .contact-line {
    margin-top: 4px; font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 10.5px; color: #4b5563;
  }
  .contact-line .sep { margin: 0 8px; color: #9ca3af; }
  .rule { border: 0; border-top: 3px solid #0b1f3a; margin: 8px 0 18px; }
  .doc-title {
    text-align: center; font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 17px; font-weight: 700; letter-spacing: 3px; color: #0b1f3a;
    margin-bottom: 20px;
  }
  .meta-row { display: flex; justify-content: space-between; margin-bottom: 14px; }
  .meta-row div { font-size: 12px; }
  .addressee { margin-bottom: 12px; }
  .addressee .name { font-weight: 700; }
  .salutation { margin-bottom: 10px; font-weight: 700; }
  .body-para { text-align: justify; margin-bottom: 10px; }
  .body-para strong { color: #0b1f3a; }
  .sign-grid {
    display: flex; justify-content: space-between; gap: 40px; margin-top: 26px;
    page-break-inside: avoid; break-inside: avoid;
  }
  .sign-block { flex: 1; min-width: 0; }
  .sign-block .heading {
    font-family: "Helvetica Neue", Arial, sans-serif; font-size: 10.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.8px; color: #0b1f3a; margin-bottom: 34px;
  }
  .sign-line { border-top: 1px solid #374151; padding-top: 4px; font-size: 11.5px; }
  .sign-line .sub { color: #6b7280; font-size: 10.5px; }
  .accepted-note {
    margin-bottom: 8px; padding: 4px 8px; border: 1px solid #a7f3d0; background: #ecfdf5;
    color: #065f46; font-size: 10.5px; font-family: "Helvetica Neue", Arial, sans-serif;
  }
  .section { margin-bottom: 18px; }
  .section-title {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 12.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;
    color: #0b1f3a; border-bottom: 1.5px solid #0b1f3a; padding-bottom: 3px; margin-bottom: 9px;
    page-break-after: avoid; break-after: avoid;
  }
  .term { margin-bottom: 7px; text-align: justify; page-break-inside: avoid; break-inside: avoid; }
  .term .lead { font-weight: 700; color: #0b1f3a; }
  .execution-statement { text-align: justify; margin: 14px 0 24px; }
  .exec-grid { display: flex; justify-content: space-between; gap: 40px; margin-top: 18px; }
  .exec-box { flex: 1; min-width: 0; border: 1px solid #d1d5db; padding: 14px 16px 12px; }
  .exec-box .heading {
    font-family: "Helvetica Neue", Arial, sans-serif; font-size: 10.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.8px; color: #0b1f3a; margin-bottom: 40px;
  }
  .exec-box .line { border-top: 1px solid #374151; padding-top: 4px; font-size: 11.5px; margin-bottom: 14px; }
  .exec-box .line .sub { color: #6b7280; font-size: 10.5px; }
  .page-footer {
    margin-top: 40px; padding-top: 8px; border-top: 1px solid #d1d5db; text-align: center;
    font-family: "Helvetica Neue", Arial, sans-serif; font-size: 10px; color: #6b7280;
  }
  .page-footer .co { font-weight: 700; color: #0b1f3a; text-transform: uppercase; letter-spacing: 1px; }
`;

function renderContactLine(context) {
  const parts = [context.companyWebsite, context.companyEmail, context.companyPhone]
    .map((p) => (p == null ? "" : String(p).trim()))
    .filter(Boolean);
  if (parts.length === 0) return "";
  return `<div class="contact-line">${parts
    .map((p) => esc(p))
    .join('<span class="sep">|</span>')}</div>`;
}

function renderLetterhead(context) {
  const logo = safeLogoSrc(context.logoDataUrl);
  return `
    <div class="letterhead">
      ${logo ? `<img class="logo" src="${logo}" alt="" />` : ""}
      <div class="company-name">${esc(String(context.companyName || "").toUpperCase())}</div>
      ${renderContactLine(context)}
    </div>
    <hr class="rule" />`;
}

function renderAcceptance(context, values) {
  const sig = context.signature;
  const signed = Boolean(sig && sig.signedAt);
  return `
    <div class="sign-block">
      <div class="heading">Accepted by Candidate</div>
      ${signed ? `<div class="accepted-note">Accepted electronically on ${esc(fmtDate(sig.signedAt))}</div>` : ""}
      <div class="sign-line">
        ${signed ? esc(sig.signerName || values.candidate_name) : "Signature"}
        <div class="sub">Name: ${esc(values.candidate_name)}</div>
        <div class="sub">Date: ${signed ? esc(fmtDate(sig.signedAt)) : "____________________"}</div>
      </div>
    </div>`;
}

/**
 * Build the complete multi-page offer HTML.
 *
 * @param {object} context RAW (unescaped) values. Recognised keys:
 *   companyName, companyWebsite, companyEmail, companyPhone, companyAddress, logoDataUrl,
 *   candidateName, candidateEmail, designation, department, employmentType, workLocation,
 *   reportingManager, joiningDate, offerDate, place, monthlySalary, annualSalary,
 *   signatoryName, signatoryTitle, probationMonths, probationNoticeDays, noticeDays,
 *   officeHours, workingDays, acceptanceDays, signature{signerName, signedAt},
 *   sections (override legal sections), cover, execution, defaults
 * @returns {string} HTML document
 */
export function buildMasterOfferHtml(context = {}) {
  const values = buildPlaceholderValues(context);
  const cover = context.cover || MASTER_COVER;
  const execution = context.execution || MASTER_EXECUTION;
  const sections = (Array.isArray(context.sections) && context.sections.length > 0
    ? context.sections
    : DEFAULT_LEGAL_SECTIONS
  )
    .filter((s) => s && s.enabled !== false && s.isIncluded !== false)
    .slice()
    .sort((a, b) => (a.order || 0) - (b.order || 0));

  const paragraphsHtml = (cover.paragraphs || [])
    .map((p) => `<p class="body-para">${renderRichText(p, values)}</p>`)
    .join("\n");

  const sectionsHtml = sections
    .map((section) => {
      const termsHtml = (section.terms || [])
        .filter((t) => t && t.enabled !== false)
        .map((t) => {
          const lead = t.lead ? `<span class="lead">${renderRichText(t.lead, values)}</span> ` : "";
          return `<div class="term">${lead}${renderRichText(t.text, values)}</div>`;
        })
        .join("\n");
      return `
      <div class="section">
        <div class="section-title">${esc(section.title || "")}</div>
        ${termsHtml}
      </div>`;
    })
    .join("\n");

  const footerParts = [context.companyAddress, context.companyEmail, context.companyPhone, context.companyWebsite]
    .map((p) => (p == null ? "" : String(p).trim()))
    .filter(Boolean);

  const title = `${esc(cover.title || "OFFER LETTER")}${values.candidate_name ? ` - ${esc(values.candidate_name)}` : ""}`;

  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>${title}</title>
  <style>${MASTER_CSS}</style>
</head>
<body>
  <!-- Page 1: cover letter -->
  <section class="page" data-section="cover">
    ${renderLetterhead(context)}
    <div class="doc-title">${esc(cover.title || "OFFER LETTER")}</div>
    <div class="meta-row">
      <div><strong>Date:</strong> ${esc(values.offer_date)}</div>
      <div>${values.place ? `<strong>Place:</strong> ${esc(values.place)}` : ""}</div>
    </div>
    <div class="addressee">
      <div>To,</div>
      <div class="name">${esc(values.candidate_name)}</div>
      ${values.candidate_email ? `<div>${esc(values.candidate_email)}</div>` : ""}
    </div>
    <div class="salutation">${renderRichText(cover.salutation || "Dear {{candidate_name}},", values)}</div>
    ${paragraphsHtml}
    <div class="body-para">${esc(cover.closing || "Yours sincerely,")}</div>
    <div class="sign-grid">
      <div class="sign-block">
        <div class="heading">For ${esc(values.company_name)}</div>
        <div class="sign-line">
          ${values.signatory_name ? esc(values.signatory_name) : "Authorized Signatory"}
          <div class="sub">${esc(values.signatory_title)}</div>
        </div>
      </div>
      ${renderAcceptance(context, values)}
    </div>
  </section>

  <!-- Pages 2+: terms of employment -->
  <section class="page" data-section="terms">
    ${sectionsHtml}
  </section>

  <!-- Final page: execution -->
  <section class="page" data-section="execution">
    <div class="section">
      <div class="section-title">${esc(execution.title || "EXECUTION")}</div>
      <p class="execution-statement">${renderRichText(execution.statement || "", values)}</p>
      <div class="exec-grid">
        <div class="exec-box">
          <div class="heading">For ${esc(values.company_name)}</div>
          <div class="line">Signature</div>
          <div class="line">Name: ${values.signatory_name ? esc(values.signatory_name) : "&nbsp;"}
            <div class="sub">${esc(values.signatory_title)}</div></div>
          <div class="line">Date: ____________________</div>
        </div>
        <div class="exec-box">
          <div class="heading">Candidate</div>
          <div class="line">${context.signature && context.signature.signedAt
            ? esc(context.signature.signerName || values.candidate_name)
            : "Signature"}</div>
          <div class="line">Name: ${esc(values.candidate_name)}</div>
          <div class="line">Date: ${context.signature && context.signature.signedAt
            ? esc(fmtDate(context.signature.signedAt))
            : "____________________"}</div>
        </div>
      </div>
    </div>
    <div class="page-footer">
      <div class="co">${esc(values.company_name)}</div>
      ${footerParts.length ? `<div>${footerParts.map((p) => esc(p)).join(" &nbsp;|&nbsp; ")}</div>` : ""}
    </div>
  </section>
</body>
</html>`;
}

export default {
  MASTER_TEMPLATE_CODE,
  MASTER_SECTIONS,
  DEFAULT_LEGAL_SECTIONS,
  buildMasterOfferHtml,
};
