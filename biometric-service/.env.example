# Service runtime
APP_NAME=hrms-biometric-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Internal service-to-service authentication (REQUIRED, min 32 chars; generate with: openssl rand -base64 48)
# Never commit real secrets. Must match BIOMETRIC_SERVICE_SECRET on the Node.js HRMS backend.
BIOMETRIC_INTERNAL_SECRET=

# Request & payload limits
MAX_REQUEST_BYTES=10485760
MAX_IMAGE_BASE64_CHARS=8000000
MAX_IMAGE_BYTES=6000000
MAX_IMAGE_EDGE_PX=4096

# Model weights directory & configurable ONNX model file paths
WEIGHTS_DIR=./weights
FACE_DETECTION_MODEL_PATH=
FACE_RECOGNITION_MODEL_PATH=
PAD_MODEL_PATH=
PAD_V2_MODEL_PATH=
PAD_V1SE_MODEL_PATH=

# YuNet detection & quality thresholds
YUNET_SCORE_THRESHOLD=0.7
YUNET_NMS_THRESHOLD=0.3
YUNET_TOP_K=5
MIN_FACE_SIZE_PX=60
MIN_BLUR_LAPLACIAN_VAR=0.0

# MiniFASNet PAD settings (uncalibrated defaults; calibrate before production)
PAD_MANDATORY=true
PAD_REQUIRE_DUAL_MODEL=false
PAD_THRESHOLD=0.5
PAD_V2_THRESHOLD=0.5
PAD_V1SE_THRESHOLD=0.5
PAD_V2_WEIGHT=0.5
PAD_V1SE_WEIGHT=0.5
PAD_V2_SCALE=2.7
PAD_V1SE_SCALE=4.0
PAD_INPUT_SIZE=80
PAD_LIVE_CLASS_INDEX=1
PAD_NORMALIZE_01=false
PAD_COLOR_ORDER=BGR

# ONNX Runtime CPU thread limits
ONNX_INTRA_OP_THREADS=2
ONNX_INTER_OP_THREADS=1
