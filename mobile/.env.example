# ==============================================================================
# HRMS Mobile Environment Variables
# ==============================================================================
#
# Same backend as the web app in client/. The web app uses VITE_API_URL.
# This app reads VITE_API_BASE_URL first, then VITE_API_URL as a fallback.

# Local development (Express on port 5000):
VITE_API_BASE_URL=http://localhost:5000/api

# Production (set this in the Vercel project → Settings → Environment Variables):
# VITE_API_BASE_URL=https://mern-hrms-api.vercel.app/api
#
# Also accepted: VITE_API_URL (fallback if VITE_API_BASE_URL is unset).
# Do not put JWT secrets, MongoDB URIs, or API private keys in the frontend.
