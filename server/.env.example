
# ==============================================================================
# HRMS Backend Environment Variables
# Vercel Functions & Local Development
# ==============================================================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
CENTRAL_DB_NAME=platform

# Tenant DB connection cache (F35) — limits are PER Node/Vercel instance, not global.
# See docs/TENANT_CONNECTION_MANAGEMENT.md
# TENANT_CONN_CACHE_MAX=50
# TENANT_CONN_IDLE_EVICT_MS=60000
# TENANT_MONGO_MAX_POOL_SIZE=5
# TENANT_MONGO_MIN_POOL_SIZE=0
# TENANT_MONGO_MAX_IDLE_MS=30000
# TENANT_MONGO_SERVER_SELECTION_MS=8000

# Authentication & JWT Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h
JWT_ISSUER=hrms-platform
JWT_AUDIENCE=hrms-company-users
AUTH_COOKIE_NAME=hrms_auth
# Face biometric encryption (REQUIRED in production, min 32 chars). Never reuse JWT_SECRET.
# FACE_BIOMETRIC_KEY=replace_with_openssl_rand_base64_48
# FACE_MODELS_DIR=/absolute/path/to/face-models
# ALLOW_INSECURE_FACE_BIOMETRIC_FALLBACK=true   # local dev only
#
# Liveness / PAD — strict allowlist (server/services/faceLivenessProvider.js).
# Arbitrary strings (vendor:*, challenge-response, etc.) NEVER unlock mandatory face.
# FACE_LIVENESS_PROVIDER=heuristic   # default; optional face only — NOT anti-spoofing
# FACE_LIVENESS_PROVIDER=minifasnet  # reserved Phase 2; not implemented — still blocks mandatory face
# Do NOT enable mandatory face in production until MiniFASNet PAD is integrated and ready.

# NEVER enable in production. Test harness only:
# ALLOW_LEGACY_NATIVE_HMAC_PROOF=true
# HRMS_NATIVE_CLIENT_SECRET=test-only-secret-min-16-chars
# Do not configure PLAY_INTEGRITY_* or VITE_HRMS_NATIVE_CLIENT_SECRET.
BCRYPT_ROUNDS=12
ONBOARDING_TOKEN_EXPIRES_IN=7d
OFFER_SIGNING_TOKEN_EXPIRES_IN=14d
CANDIDATE_ONBOARDING_TOKEN_EXPIRES_IN=14d
EMPLOYEE_ACTIVATION_EXPIRES_IN=7d

# Frontend URL / CORS
CLIENT_URL=https://mern-project-nu-nine.vercel.app
FRONTEND_URL=https://mern-project-nu-nine.vercel.app

# Existing email configuration — optional environment fallback
SMTP_USER=your.email@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password
EMAIL_FROM=HRMS Platform <your.email@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# EMAIL_SETTINGS_SECRET=replace_with_a_secure_random_secret

# Scheduled announcement publication. Set this on the API project only.
# Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
# ANNOUNCEMENT_CRON_SECRET is an optional fallback for a manual caller.
# Do not put either value in the frontend. Leave both empty until a scheduler is configured.
# CRON_SECRET=
# ANNOUNCEMENT_CRON_SECRET=
EMAIL_RATE_LIMIT_PER_MINUTE=20
EMAIL_HTTP_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# Messages chat attachments — tenant MongoDB GridFS (bucket: chat_attachments)
# Uses the same Atlas/Mongo connection as the rest of HRMS. No R2 / local disk.
# Optional limits (request body is still base64 over JSON; stay under Vercel 4.5 MB):
# CHAT_ATTACHMENT_MAX_BYTES=3145728
# CHAT_ATTACHMENT_MAX_COUNT=5
# ------------------------------------------------------------------------------

# Optional document upload directory (employee documents / local logo mirror).
# Vercel temporary storage is ephemeral; company logos are persisted in MongoDB
# (Company.branding.logoData) and streamed via GET /api/auth/company-logo.
# Set UPLOADS_DIR only for persistent VM disks (e.g. Render) if you need file storage:
# UPLOADS_DIR=/var/data/uploads

# Optional local seed / provisioning configuration
# SEED_COMPANY_CODE=acme
# SEED_COMPANY_NAME=Acme
# SEED_DATABASE_NAME=company_acme
# SEED_HR_ADMIN_EMAIL=hr@acme.test
# SEED_HR_ADMIN_PASSWORD=change-me
# SEED_EMPLOYEE_EMAIL=employee@acme.test
# SEED_EMPLOYEE_PASSWORD=change-me

# Google Gemini AI Integration (Phase 1)
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Offer letter documents — MongoDB GridFS (bucket offer_docs per tenant DB)
# See server/docs/offer-template-phase1-gridfs-implementation-plan.md
# R2 is NOT required for Phase 1.
# ------------------------------------------------------------------------------
# OFFER_DOCX_MAX_BYTES=2097152
# OFFER_PDF_MAX_BYTES=5242880
# OFFER_TEMPLATE_VERSION_RETENTION=5

# Optional: override Chrome path (CI / custom hosts)
# PUPPETEER_EXECUTABLE_PATH=
# Optional remote Chromium pack URL if using @sparticuz/chromium-min
# CHROMIUM_REMOTE_EXECUTABLE_PATH=

# Optional self-hosted LibreOffice/unoserver DOCX→PDF worker (no paid fallback)
# LIBREOFFICE_CONVERT_URL=
# LIBREOFFICE_CONVERT_TOKEN=

